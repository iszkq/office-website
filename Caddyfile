:80 {
    root * /srv

    # ONLYOFFICE ships several large JavaScript bundles. Compress text assets
    # at the origin so the lightweight public reverse proxy only forwards the
    # smaller response body.
    encode zstd gzip

    # The editor receives decrypted documents in the browser. Keep every
    # executable and network request on this origin so third-party code cannot
    # observe or exfiltrate document content.
    header {
        Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        X-Content-Type-Options "nosniff"
    }

    # Serve static files; return a genuine 404 if the file doesn't exist
    # (do NOT fall back to index.html — Next.js static export has a real
    # HTML file for every route, and a fake 200 would pollute caches).
    file_server

    # Next.js static export writes /foo/index.html and /foo.html.
    # Try both variants so clean URLs work, but stop there.
    try_files {path} {path}.html {path}/index.html

    # Prevent 404 (and other error) responses from being cached by
    # browsers or intermediate proxies.
    handle_errors {
        header Cache-Control "no-store"
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }

    # Cache immutable versioned OnlyOffice assets (1 year)
    @onlyoffice_versioned {
        path /v*-*/*
    }
    header @onlyoffice_versioned Cache-Control "public, max-age=31556952, immutable"

    # Next.js filenames are content-hashed as well and are safe to keep across
    # editor opens. This avoids downloading the bridge application repeatedly.
    @next_static {
        path /_next/static/*
    }
    header @next_static Cache-Control "public, max-age=31556952, immutable"

    # Pre-compressed x2t bundles. Android System WebView 103 cannot load the
    # Brotli response, so image builds also provide the same runtime as gzip.
    @x2t_brotli {
        path /x2t-1/*
    }
    header @x2t_brotli Content-Encoding br
    header @x2t_brotli Cache-Control "public, max-age=31556952, immutable"

    @x2t_webview {
        path /x2t-compat/*
    }
    header @x2t_webview Content-Encoding gzip
    header @x2t_webview Cache-Control "public, max-age=31556952, immutable"
}
