/*
    Content-Security-Policy: default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' blob:; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'
    Referrer-Policy: no-referrer
    Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
    X-Content-Type-Options: nosniff

/x2t-1/*
    Content-Encoding: br
    Cache-Control: public, max-age=31556952, immutable

/x2t-compat/*
    Content-Encoding: gzip
    Cache-Control: public, max-age=31556952, immutable

/v9.4.0.1-*
    Cache-Control: public, max-age=31556952, immutable

# nextjs
/_next/static/*
    Cache-Control: public, max-age=31556952, immutable
/*.txt
    Cache-Control: public, max-age=600
/*.json
    Cache-Control: public, max-age=600

# template files
/files/*
    Cache-Control: public, max-age=86400
